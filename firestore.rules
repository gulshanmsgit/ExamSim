rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each library lives under an unguessable sync code (24+ characters).
    // There is no rule for listing /workspaces itself, so nobody can
    // browse other people's libraries: you need the exact code.
    match /workspaces/{ws}/{coll}/{docId} {
      allow read, write: if ws.size() >= 24
        && coll in ['subjects', 'topics', 'sets', 'setq', 'attempts'];
    }
  }
}
